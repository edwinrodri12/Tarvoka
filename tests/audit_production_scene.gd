extends SceneTree
## Production census must include geometry generated by _ready(), not just serialized nodes.
## Run: godot --headless --path . --script res://tests/audit_production_scene.gd -- res://scenes/G11AndroidStressLab.tscn
const Audit = preload("res://scripts/tools/MeshBudgetAudit.gd")

func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	if args.size() != 1 or not args[0].begins_with("res://") or not args[0].ends_with(".tscn"):
		push_error("Usage: -- res://path/to/production_scene.tscn")
		quit(2)
		return
	call_deferred("_run_census", args[0])

func _run_census(path: String) -> void:
	if not ResourceLoader.exists(path, "PackedScene"):
		push_error("Production scene missing: " + path)
		quit(3)
		return
	var scene := load(path) as PackedScene
	if scene == null:
		push_error("Cannot load PackedScene: " + path)
		quit(4)
		return
	var instance := scene.instantiate()
	if instance == null:
		push_error("Cannot instantiate scene: " + path)
		quit(4)
		return
	root.add_child(instance)
	# _ready() may construct the actual meshes; give deferred children one frame.
	await process_frame
	var report: Dictionary = Audit.inspect(instance)
	instance.queue_free()
	if not Audit.is_valid_report(report):
		push_error("Invalid or inconsistent geometry census")
		quit(5)
		return
	if report["mesh_nodes"] == 0:
		push_error("No geometry in live scene; refusing false-positive production census: " + path)
		quit(6)
		return
	print("MESH_PRODUCTION_CENSUS " + JSON.stringify({"scene": path, "report": report}))
	quit(0)
