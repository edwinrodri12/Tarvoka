extends SceneTree

const Lab = preload("res://scripts/ui/VisualLab.gd")
const Roles = preload("res://scripts/core/UnitRoles.gd")
const Arsenal = preload("res://scripts/core/ModernArsenal.gd")
const Main = preload("res://scripts/ui/Main.gd")
const Session = preload("res://scripts/core/BattleSession.gd")
const VFX = preload("res://scripts/ui/BattleVFX.gd")

func _initialize() -> void:
    call_deferred("_run")

func _run() -> void:
    var lab = Lab.new()
    root.add_child(lab)
    assert(not lab.visible)
    assert(lab.CATALOG.size() == 32)
    assert(lab.CATALOG.size() == Roles.ORDER.size()+Arsenal.ORDER.size())
    assert(lab.attacker_picker.item_count == 32)
    assert(lab.defender_picker.item_count == 32)
    assert(lab.attacker_faction_picker.item_count == 8)
    assert(lab.defender_faction_picker.item_count == 8)
    assert(lab.terrain_picker.item_count == 5)
    assert(lab.distance_picker.item_count == 5)
    assert(lab.speed_picker.item_count == 3)
    assert(lab.render_picker.item_count == 2)
    assert(lab.lab_board.autosave_enabled == false)
    assert(lab.lab_board.ai_enabled == false)
    assert(lab.lab_board.is_processing() == false)
    lab.open_lab()
    assert(lab.visible)
    assert(lab.lab_board.iso_enabled)
    assert(lab.lab_board.is_processing())
    assert(lab.lab_board.state["units"].size() == 2)
    var before: Dictionary = lab.lab_board.state.duplicate(true)
    assert(before["units"][0]["role"] == "tank")
    assert(before["units"][1]["role"] == "ifv")
    assert(before["units"][0]["display_faction"] == 0)
    assert(before["units"][1]["display_faction"] == 1)
    assert(before["faction"] == 0)
    assert(lab.details_label.text.contains("Tanque principal"))
    assert(lab.lab_board.visual_playback_speed == 1.0)

    # Real battle uses authoritative combat results and changes LAB ONLY.
    var expected: Dictionary = Session.attack(before,"LAB-A","LAB-B")
    assert(expected.get("valid",false))
    lab.demo_attack()
    assert(lab.lab_board.state == expected["state"])
    assert(lab.lab_board.combat_effects.size() == 1)
    assert(int(lab.lab_board.combat_effects[0]["damage"]) == int(expected["damage"]))
    assert(int(lab.lab_board.combat_effects[0]["counter_damage"]) == int(expected["counter_damage"]))
    assert(lab.feedback_label.text.contains("COMBATE REAL"))
    lab.repeat_action()
    assert(lab.lab_board.state == expected["state"])

    # Visual FX is explicitly non-authoritative.
    lab.attacker_picker.select(lab.CATALOG.find("ew"))
    lab.defender_picker.select(lab.CATALOG.find("tank"))
    lab.rebuild_stage()
    var invalid: Dictionary = lab.lab_board.state.duplicate(true)
    assert(not Session.attack(invalid,"LAB-A","LAB-B").get("valid",false))
    lab.demo_attack()
    assert(lab.lab_board.state == invalid)
    assert(lab.lab_board.combat_effects.is_empty())
    lab.demo_fx()
    assert(lab.lab_board.combat_effects.size() == 1)
    assert(lab.lab_board.combat_effects[0]["damage"] == 0)
    assert(lab.lab_board.combat_effects[0]["counter_damage"] == 0)
    assert(lab.lab_board.state == invalid)
    assert(lab.feedback_label.text.contains("SOLO EFECTOS"))
    assert(not lab.lab_board.autosave_enabled)

    # Every catalog entry can be shown even when it has no 3D mesh yet.
    for index in range(lab.CATALOG.size()):
        lab.attacker_picker.select(index)
        lab.rebuild_stage()
        assert(lab.lab_board.state["units"][0]["role"] == lab.CATALOG[index])
        assert(lab.lab_board.state["winner"] == -1)
    lab.attacker_picker.select(lab.CATALOG.find("tank"))
    lab.defender_picker.select(lab.CATALOG.find("apc"))
    lab.distance_picker.select(3)
    lab.terrain_picker.select(1)
    lab.attacker_faction_picker.select(7)
    lab.defender_faction_picker.select(4)
    lab.speed_picker.select(0)
    lab.rebuild_stage()
    assert(lab.lab_board.state["units"][0]["display_faction"] == 7)
    assert(lab.lab_board.state["units"][1]["display_faction"] == 4)
    assert(lab.lab_board.state["units"][0]["faction"] == 0)
    assert(lab.lab_board.state["units"][1]["faction"] == 1)
    assert(lab.lab_board.visual_playback_speed == 0.5)
    assert(lab.lab_board.state["terrain"][3][6] == "forest")
    lab.demo_move()
    assert(lab.lab_board.motion_effects.size() == 1)
    assert(lab.lab_board.motion_effects[0].has("route"))
    assert(lab.lab_board.motion_effects[0].has("duration"))
    assert(lab.lab_board.motion_effects[0]["from"] != lab.lab_board.motion_effects[0]["to"])
    assert(lab.feedback_label.text.contains("MOVIMIENTO REAL"))
    lab.repeat_action()
    assert(lab.lab_board.motion_effects.size() == 1)
    lab._set_playback_speed(2)
    assert(lab.lab_board.visual_playback_speed == 1.5)
    lab._set_render_mode(1)
    assert(not lab.lab_board.models_3d_enabled)
    lab._set_render_mode(0)
    assert(lab.lab_board.models_3d_enabled)

    # Naval/air domain mixed pairings are explorable without crashing.
    lab.attacker_picker.select(lab.CATALOG.find("destroyer"))
    lab.defender_picker.select(lab.CATALOG.find("submarine"))
    lab.terrain_picker.select(4)
    lab.rebuild_stage()
    assert(lab.lab_board.state["terrain"][3][2] == "water")
    assert(lab.lab_board.state["terrain"][3][6] == "water")
    lab.attacker_picker.select(lab.CATALOG.find("fighter"))
    lab.defender_picker.select(lab.CATALOG.find("tank"))
    lab.rebuild_stage()
    assert(lab.lab_board.state["units"].size() == 2)
    lab._swap_units()
    assert(lab.lab_board.state["units"][0]["role"] == "tank")

    lab.close_lab()
    assert(not lab.visible)
    assert(not lab.lab_board.is_processing())
    lab.queue_free()

    # Most important isolation assertion: opening/closing lab cannot overwrite
    # the actual Main board or its pending order, AI, autosave or UI settings.
    var main_scene: PackedScene = load("res://scenes/Main.tscn")
    assert(main_scene != null)
    var app: Control = main_scene.instantiate()
    root.add_child(app)
    var game_board: Control = app.get("board")
    var saved: Dictionary = game_board.state.duplicate(true)
    var game_autosave: bool = game_board.autosave_enabled
    var lab_overlay: Control = app.get("visual_laboratory")
    assert(lab_overlay != null and not lab_overlay.visible)
    assert(app.get("visual_laboratory_button") != null)
    assert(app.get("visual_laboratory_quick") != null)
    app._open_visual_lab()
    assert(lab_overlay.visible)
    assert(game_board.state == saved)
    lab_overlay.demo_fx()
    lab_overlay.demo_attack()
    lab_overlay.close_lab()
    assert(not lab_overlay.visible)
    assert(game_board.state == saved)
    assert(game_board.autosave_enabled == game_autosave)
    app.queue_free()
    print("PASS visual laboratory: all 32 units, 8 skins, terrain, real attack vs visual FX, speed, movement, save isolation")
    quit(0)
