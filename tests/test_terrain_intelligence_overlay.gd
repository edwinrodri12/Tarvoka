extends SceneTree

const Overlay = preload("res://scripts/ui/TerrainIntelOverlay.gd")
const Rules = preload("res://scripts/core/Rules.gd")
const Roles = preload("res://scripts/core/UnitRoles.gd")
const Logistics = preload("res://scripts/core/Logistics.gd")
const Session = preload("res://scripts/core/BattleSession.gd")
const Visibility = preload("res://scripts/core/Visibility.gd")
const Scenarios = preload("res://scripts/core/Scenarios.gd")

func _initialize() -> void:
    call_deferred("_run")

func _run() -> void:
    var tank: Dictionary = Roles.make_unit("T",0,Vector2i(1,1),"tank")
    var enemy: Dictionary = Roles.make_unit("X",1,Vector2i(8,6),"line")
    var field: Array = Scenarios.terrain(1)
    var state: Dictionary = Session.start([tank,enemy],field,0,true)
    var original: Dictionary = state.duplicate(true)
    var tank_context: Dictionary = Overlay.context_for(state,"T")
    assert(bool(tank_context["motorized"]) and str(tank_context["domain"]) == "ground")
    assert(Overlay.badge("road",Vector2i(2,1),Overlay.MOBILITY,tank_context)["label"] == "½")
    assert(is_equal_approx(float(Overlay.badge("road",Vector2i(2,1),Overlay.MOBILITY,tank_context)["cost"]),0.5))
    assert(Overlay.badge("forest",Vector2i(2,1),Overlay.DEFENSE,tank_context)["cover"] == 1)
    assert(Overlay.badge("mountain",Vector2i(2,1),Overlay.DEFENSE,tank_context)["cover"] == 2)
    assert(Overlay.badge("plain",Vector2i(2,1),Overlay.DEFENSE,tank_context).is_empty())
    assert(Overlay.badge("water",Vector2i(2,1),Overlay.MOBILITY,tank_context)["cost"] == -1)
    var infantry: Dictionary = Roles.make_unit("I",0,Vector2i(1,1),"line")
    var infantry_state: Dictionary = Session.start([infantry,enemy],field)
    var infantry_context: Dictionary = Overlay.context_for(infantry_state,"I")
    assert(not bool(infantry_context["motorized"]))
    assert(Overlay.badge("road",Vector2i(2,1),Overlay.MOBILITY,infantry_context)["label"] == "1")
    var slow_context: Dictionary = infantry_context.duplicate(true)
    slow_context["move_points"] = 2
    assert(Overlay.badge("mountain",Vector2i(4,0),Overlay.MOBILITY,slow_context)["label"] == "3*")
    assert(Rules.reachable(Vector2i(3,0),2,field,[]).has(Vector2i(4,0)))
    slow_context["cities"] = {Vector2i(2,1):true}
    assert(Overlay.badge("plain",Vector2i(2,1),Overlay.DEFENSE,slow_context)["cover"] == 1)
    var helicopter: Dictionary = Roles.make_unit("H",0,Vector2i(1,1),"attack_heli")
    var air_state: Dictionary = Session.start([helicopter,enemy],field)
    var air_context: Dictionary = Overlay.context_for(air_state,"H")
    assert(str(air_context["domain"]) == "air")
    assert(Overlay.badge("mountain",Vector2i(4,0),Overlay.DEFENSE,air_context).is_empty())
    assert(Overlay.badge("water",Vector2i(4,0),Overlay.MOBILITY,air_context)["cost"] == 1)
    var explored: Dictionary = Visibility.explored_cells(state,0)
    assert(Overlay.can_show_cell(true,explored,Vector2i(1,1)))
    assert(not Overlay.can_show_cell(true,explored,Vector2i(8,6)))
    assert(Overlay.can_show_cell(false,{},Vector2i(8,6)))
    assert(Overlay.badge("mountain",Vector2i(4,0),Overlay.DEFENSE,tank_context,true)["opacity"] < 1.0)
    assert(Overlay.context_for(state,"X")["motorized"] == false)
    assert(state == original)

    # Actual Android/desktop command widgets toggle only a local view flag.
    var view: Control = load("res://scenes/Main.tscn").instantiate()
    root.add_child(view)
    await process_frame
    var board = view.board
    assert(view.terrain_overlay_button != null and view.compact_terrain_button != null)
    assert(view.expanded_terrain_button != null)
    assert(board.terrain_overlay_mode == Overlay.OFF)
    var saved: Dictionary = board.state.duplicate(true)
    view._toggle_terrain_overlay()
    assert(board.terrain_overlay_mode == Overlay.DEFENSE)
    assert(view.compact_terrain_button.text == "DEF")
    assert(view.terrain_overlay_button.text.contains("defensa"))
    view._toggle_terrain_overlay()
    assert(board.terrain_overlay_mode == Overlay.MOBILITY and view.compact_terrain_button.text == "MOV")
    board.set_isometric(true)
    board.queue_redraw()
    view._toggle_terrain_overlay()
    assert(board.terrain_overlay_mode == Overlay.OFF)
    view._set_compact_hud(true)
    assert(view.compact_terrain_button.visible)
    view._set_compact_hud(false)
    assert(not view.compact_terrain_button.visible)
    assert(board.state == saved)
    view.queue_free()
    print("PASS tactical terrain layer: road half-cost, mountain cover, slow climb, air separation, fog, HUD and save immutability")
    quit(0)
